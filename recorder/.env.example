# Copy to recorder/.env (gitignored) and fill in. Never commit real credentials.

# Path to ffmpeg/ffprobe if they are not on PATH (winget installs them under WinGet\Packages).
# FFMPEG=
# FFPROBE=

# --- FastGym (local: `pnpm dev` in the fastgym repo) ---
FG_URL=http://localhost:3001
# Set when the FastGym API runs somewhere other than :3000, e.g. http://localhost:3002
# FG_API_URL=
FG_EMAIL=owner@fastgym.dev
# Password of that user, from apps/api/prisma/seed.ts in the fastgym repo.
FG_PASSWORD=
# Member to check in at the kiosk (2+ letters). fg-members creates Valeria Rodríguez.
FG_MEMBER_SEARCH=Valeria Rodr

# --- Autogestion (local frontend http://localhost:5173 or the DEV site) ---
AUT_URL=
AUT_EMAIL=
AUT_PASSWORD=
# 1 = actually send the vacation request (creates a real request in that environment).
AUT_SUBMIT=0
# 1 = the user is a supervisor: also show the approval dialog (never approves).
AUT_SHOW_APPROVALS=0
# 1 = turn on the ai_mode Flagsmith flag in the recording browser only.
AUT_FORCE_AI_FLAG=0
# Questions for AI mode, separated by |
# AUT_AI_QUESTIONS=¿Cuántos días de vacaciones tengo disponibles?|Muéstrame mis últimos comprobantes de pago

# --- Portfolio smoke test ---
PORTFOLIO_URL=http://localhost:3000
